################################################################################
# Address: 80375384 
# After bootloader heap is created
# This file will create a heap for slippi audio caches
# TIP: size of the audio heap is set to 3291584 by the game 
# TIP: heap id is 1 for audio
################################################################################

.include "Common/Common.s"
.include "Online/Online.s"
.include "Online/Core/Music/Music.s"

.set  REG_HeapLo,31
.set  REG_HeapSize,28
.set  REG_HeapID,26

# Original codeline
  branchl r12,0x803444e0

backup


#Align
  load  REG_HeapSize, 3291584
  rlwinm	REG_HeapSize, REG_HeapSize, 0, 0, 26
#Create heap of this size
  add r4,REG_HeapLo,REG_HeapSize     #heap hi = start + filesize
  addi r4,r4, 32                     #heap hi, 32 bytes padding?
  mr  r3,REG_HeapLo                  #heap lo = start
  mr  REG_HeapLo,r4                  #new start = heap hi
  branchl r12,OSCreateHeap
  mr  REG_HeapID,r3

# store heap id into dynamic data
  computeBranchTargetAddress r3, INJ_fileLoad_HPS
  stb REG_HeapID, IDO_HPS_HEAP_ID(r3) 

  b Exit

Exit:
  restore

# overwrite r31 which stores the low bound. A few upcoming instructions rely
# on this to initialize the heap
  lwz r31, -0x3FE8(r13)
  
# original instruction
  addi	r3, r31, 31
